# Porta da aplicação
PORT=8081

# URL do GLPI
GLPI_URL=https://grupolipetral.verdanadesk.com

# Tokens da API REST do GLPI
GLPI_APP_TOKEN=seu_app_token_aqui
GLPI_USER_TOKEN=seu_user_token_aqui

# Grupo Técnico (Padrão 1 = Sistemas)
GLPI_TECH_GROUP=1

# Identificação do usuário para o Kanban
MY_USER_ID=20
MY_USER_NAME=Roberto

# Banco SQLite local
DB_PATH=data/kanban.db

# Intervalo de auto-refresh em segundos (Frontend AJAX)
REFRESH_INTERVAL_SEC=30

# Logs
LOG_MAX_SIZE_MB=50
LOG_MAX_AGE_DAYS=30
